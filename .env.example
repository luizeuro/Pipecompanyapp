# Copie para .env só se quiser rodar localmente contra o Supabase de verdade.
# Sem SUPABASE_URL, o backend local usa um banco em memória com dados de demonstração.
# Em produção, TODAS estas variáveis ficam na Vercel (Settings → Environment Variables).

# Banco (Supabase → Project Settings → API Keys). Use a chave SECRETA
# (secret / service_role): só o backend a usa, nunca vai para o navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Segredos do app (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# CRON_SECRET: o Cron da Vercel manda esse valor sozinho ao chamar /api/cron/check.
ENCRYPTION_KEY=
JWT_SECRET=
CRON_SECRET=

# CAPTCHA do login (opcional) — Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# Meta Ads (token de usuário do sistema do Business Manager com ads_read)
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
# META_API_VERSION=v25.0

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_API_VERSION=v25

# E-mail de alertas (resend.com)
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Resumo diário por e-mail
CHECK_TIMEZONE=America/Sao_Paulo
CHECK_HOUR=09:00

# URL pública do app (usada nos links dos e-mails). Na Vercel é opcional.
# APP_URL=https://pipecompanyapp.vercel.app
